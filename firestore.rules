rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      // ✅ READ - Avelao hamaky ny rehetra raha tafiditra
      allow read: if request.auth != null;
      
      // ✅ CREATE - Avelao hamorona ny tena profil ihany
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // ✅ UPDATE - Avelao hanova ny tena profil ihany
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // ✅ DELETE - Avelao hamafa ny tena profil ihany
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================================
    // POSTS COLLECTION
    // ============================================================
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.author.id == request.auth.uid;
    }
    
    // ============================================================
    // COMMENTS COLLECTION
    // ============================================================
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.author.id == request.auth.uid;
    }
    
    // ============================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // EVENTS COLLECTION
    // ============================================================
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.organizer.id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.organizer.id == request.auth.uid;
    }
    
    // ============================================================
    // CONVERSATIONS COLLECTION
    // ============================================================
    match /conversations/{conversationId} {
      allow read: if request.auth != null && 
        (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid in resource.data.participants);
      allow delete: if request.auth != null && 
        (request.auth.uid in resource.data.participants);
    }
    
    // ============================================================
    // MESSAGES SUBCOLLECTION
    // ============================================================
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null && 
        (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }
  }
}